# Local/owner review needs no secrets or database.
# Do not set these until documented owner approval and media clearance.
SITE_URL=http://localhost:3000
SITE_APPROVED_FOR_LAUNCH=false
CONTENT_AND_MEDIA_APPROVED=false

# Community features require owner-created Google OAuth credentials, the reviewed
# Supabase migration, and server-only secrets. Leave these unset until activation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public origin used for OAuth callback allowlisting (no trailing path).
AUTH_REDIRECT_ORIGIN=http://127.0.0.1:3001
SUPABASE_SECRET_KEY=
# Random, server-only string of at least 32 characters for hashed rate counters.
RATE_LIMIT_PEPPER=
