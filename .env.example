# Local/owner review needs no secrets or database.
# Do not set these until documented owner approval and media clearance.
SITE_URL=http://localhost:3000
SITE_APPROVED_FOR_LAUNCH=false
CONTENT_AND_MEDIA_APPROVED=false

# Community features require owner-created Google OAuth credentials, the reviewed
# Supabase migration, and server-only secrets. Leave these unset until activation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public origin used for OAuth callback allowlisting (no trailing path).
AUTH_REDIRECT_ORIGIN=http://127.0.0.1:3001
SUPABASE_SECRET_KEY=
# Random, server-only string of at least 32 characters for hashed rate counters.
RATE_LIMIT_PEPPER=

# Signed forms: collection is OFF by default. No keys enter browser or Git.
# JSON keyring: {"v1":"<32 cryptographically random bytes, canonical base64>"}
# Keep retired keys for existing records and encrypted-backup recovery.
FORM_ENCRYPTION_KEYS=
FORM_ACTIVE_KEY_ID=
FORM_COLLECTION_ENABLED=false
# Exact version strings from src/lib/forms/definition.ts. Set only after approval.
FORM_APPROVED_DONATION_VERSION=
# Do NOT enable this before owner/legal electronic-use approval.
FORM_APPROVED_LIABILITY_VERSION=
